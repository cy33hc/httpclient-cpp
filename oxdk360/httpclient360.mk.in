# httpclient360.mk -- OXDK360 build glue for httpclient-cpp, built for the Xbox
# 360 against the port's libcurl.
#
# Include this from a project Makefile *after* oxdk.mk, then hand its flags and
# objects to the build:
#
#   OXDK_DIR       := /path/to/OXDK
#   OXDK_TARGET    := xbox360
#   XENON_ABI      := 1
#   OXDK360_LIBCXX := 1
#   SRCS           := main.cpp
#   XEX_TITLE      := mytitle
#
#   include $(OXDK_DIR)/oxdk.mk
#   include $(OXDK_DIR)/xbox360/third-party/httpclient/oxdk360/httpclient360.mk
#
#   CXXFLAGS += $(HTTPCLIENT360_CFLAGS) -fexceptions
#   OBJS     += $(HTTPCLIENT360_OBJS)
#
# Four things about those lines are load-bearing rather than stylistic:
#
#   OXDK360_LIBCXX := 1  this library is compiled against OXDK's libc++ headers
#                        and links its compiled half, so a title that takes the
#                        XDK's own C++ headers instead has two different
#                        spellings of std::string on one link line.
#
#   CXXFLAGS, not CFLAGS xbox360.mk's rule for a .cpp file is
#                        `$(CLANG) $(OXDK360_CXXFLAGS) $(CXXFLAGS)`; its C rule
#                        is the one that reads CFLAGS.
#
#   -fexceptions         libc++'s headers are compiled into the title as well as
#                        into the archive, and both halves have to agree on
#                        _LIBCPP_HAS_EXCEPTIONS. The throw path itself is inside
#                        the archive.
#
#   OBJS after oxdk.mk   that is where its link rule reads the object list when
#                        it runs, and the archives are listed last there so the
#                        XDK libraries after them still resolve their CRT
#                        references.
#
# HTTPCLIENT360_CFLAGS is the whole flag answer for a project that would rather
# use one variable; HTTPCLIENT360_INCLUDES, _DEFS and _FORCE are its pieces.

# Generated by `make -f Makefile.oxdk360 install` in the httpclient-cpp source
# tree.
#
# Guarded because a composite fragment could include this one, and a project
# that also included it directly would otherwise redefine the copy rules below
# and make warn about overriding the recipe.
ifndef HTTPCLIENT360_MK_INCLUDED
HTTPCLIENT360_MK_INCLUDED := 1

HTTPCLIENT360_ROOT ?= @HTTPCLIENT360_ROOT@

ifeq ($(OUTPUT_DIR),)
$(error httpclient360.mk must be included after oxdk.mk)
endif

# libcurl first, and not as a convenience. Every symbol this archive defines is
# a call into libcurl, so the title's link line needs libcurl.a, BearSSL, xnet
# and oldnames whether or not the title itself names a curl function. The
# fragment also puts curl's two shim headers and its <curl/curl.h> on the
# include path, which is where <curl/curl.h> has to come from.
CURL360_MK ?= @CURL360_MK@

ifeq ($(wildcard $(CURL360_MK)),)
$(error libcurl for the Xbox 360 is not installed. Looking for $(CURL360_MK), \
which httpclient360.mk was generated with. Build and install it from the curl \
source tree, or set CURL360_MK to its curl360.mk)
endif

include $(CURL360_MK)

# Two directories, and the order between them is load-bearing:
#
#   include/httpclient                HTTPClient.h and CurlHandle.h, included by
#                                     bare name as upstream's source does.
#   oxdk360/include                    httpclient360.h, the force-include.
#
# curl's own shim directory comes first, ahead of OXDK's libc++ <windows.h>,
# because the console's <winsockx.h> can only be reached in one order; see the
# header. CURL360_INCLUDES already places it, so it is kept where it is and this
# adds to it rather than reordering it.
HTTPCLIENT360_INCLUDES := -I$(HTTPCLIENT360_ROOT)/include/httpclient \
                          -isystem $(HTTPCLIENT360_ROOT)/oxdk360/include \
                          $(CURL360_INCLUDES)

# The same two defines the library and libcurl were built with. Both are ABI
# rather than convenience: without CURL_STATICLIB <curl/curl.h> declares every
# public function dllimport, and without _INTEGRAL_MAX_BITS=64 a title's
# curl_off_t is 32 bits where the archive's is 64, which is the type of
# CURLOPT_INFILESIZE_LARGE and every curl_off_t in the API.
# -DDEBUG_CURL has to match the archive it accompanies: HTTPClient.h gates member
# variables on it -- the trace file lives inside #if DEBUG_CURL -- so a title
# compiled with the header's own default of 1 against an archive built with 0
# would disagree about the class layout. The library's Makefile substitutes the
# value it was built with, so reinstall after changing it.
HTTPCLIENT360_DEFS := $(CURL360_DEFS) -DCURL_STATICLIB -D_INTEGRAL_MAX_BITS=64 \
                      -DDEBUG_CURL=@DEBUG_CURL@

# Force-included ahead of every translation unit of the title too. It is what
# puts <windows.h> before <curl/curl.h>, without which a title that includes
# HTTPClient.h -- which includes <curl/curl.h> -- does not compile at all.
HTTPCLIENT360_FORCE := -include httpclient360.h

# The include directories, the defines and the force-include, in one variable
# for a project that would rather not spell them.
HTTPCLIENT360_CFLAGS := $(HTTPCLIENT360_INCLUDES) $(HTTPCLIENT360_DEFS) \
                        $(HTTPCLIENT360_FORCE)

# What the archive needs from the C++ runtime the headers describe. The libc++
# archive is here because there is no other copy of it to find; OXDK's exception
# entries, its compiler helpers and the out-of-line std::string pieces are
# already inside libhttpclient.a, so a title does not compile them again.
HTTPCLIENT360_LIB := $(HTTPCLIENT360_ROOT)/lib/libhttpclient.a
HTTPCLIENT360_LIBCXX := $(HTTPCLIENT360_ROOT)/lib/libcxx-xenon.a

# Order matters on the link line: this archive first, then libc++'s compiled
# half, then libcurl and BearSSL, then the XDK libraries curl360.mk appends.
# httpclient-cpp's objects name libc++ entities and curl functions; nothing
# below names them back.
HTTPCLIENT360_OBJS := $(HTTPCLIENT360_LIB) $(HTTPCLIENT360_LIBCXX) $(CURL360_OBJS)

$(XEX): $(HTTPCLIENT360_OBJS)

endif
